Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  servers = [
    { name: "load-balancer", ip: "192.168.56.10", memory: 512 },
    { name: "web-01",        ip: "192.168.56.11", memory: 512 },
    { name: "web-02",        ip: "192.168.56.12", memory: 512 },
    { name: "app-server",    ip: "192.168.56.13", memory: 1024 },
    { name: "backup-server", ip: "192.168.56.14", memory: 512 }
  ]

  servers.each do |server|
    config.vm.define server[:name] do |node|
      node.vm.hostname = server[:name]
      node.vm.network "private_network", ip: server[:ip]

      node.vm.provider "virtualbox" do |vb|
        vb.name = server[:name]
        vb.memory = server[:memory]
        vb.cpus = 1
        vb.gui = false
      end

      # Provision Docker on web servers and app server
      if ["web-01", "web-02", "app-server"].include?(server[:name])
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update -y
          apt-get install -y docker.io
          systemctl enable --now docker
          usermod -aG docker vagrant
        SHELL
      end

      # Provision HAProxy on load balancer
      if server[:name] == "load-balancer"
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update -y
          apt-get install -y haproxy
          systemctl enable --now haproxy
          cp /vagrant/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg
          systemctl restart haproxy
          systemctl enable haproxy
        SHELL
      end

      # Provision rsync on backup server
      if server[:name] == "backup-server"
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update -y
          apt-get install -y rsync
        SHELL
      end
    end
  end
end

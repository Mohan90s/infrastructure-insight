Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # Load environment variables from local .env file if present
  env_file = File.expand_path(".env", __dir__)
  if File.exist?(env_file)
    File.readlines(env_file).each do |line|
      line = line.strip
      next if line.empty? || line.start_with?("#")
      k, v = line.split("=", 2)
      ENV[k.strip] ||= v.strip if k && v
    end
  end

  stats_user = ENV["HAPROXY_STATS_USER"] || "admin"
  stats_pass = ENV["HAPROXY_STATS_PASSWORD"].to_s
  if stats_pass.empty? && (ARGV & %w[up provision reload]).any?
    abort("ERROR: Please set HAPROXY_STATS_PASSWORD in your .env file")
  end

  # backup-server is defined FIRST so its SSH key is created before app-server provisions
  servers = [
    { name: "backup-server", ip: "192.168.56.14", memory: 512 },
    { name: "load-balancer", ip: "192.168.56.10", memory: 512 },
    { name: "web-01",        ip: "192.168.56.11", memory: 512 },
    { name: "web-02",        ip: "192.168.56.12", memory: 512 },
    { name: "app-server",    ip: "192.168.56.13", memory: 1024 }
  ]

  servers.each do |server|
    config.vm.define server[:name] do |node|
      node.vm.hostname = server[:name]
      node.vm.network "private_network", ip: server[:ip]
      node.vm.network :forwarded_port, guest: 22, host: 2222, id: "ssh", auto_correct: true
      node.vm.provider "virtualbox" do |vb|
        vb.name = server[:name]
        vb.memory = server[:memory]
        vb.cpus = 1
        vb.gui = false
      end

      # 1. BASE SETUP: Create 'devops' user across all VMs
      node.vm.provision "shell", inline: <<-SHELL
        useradd -m -s /bin/bash devops || true
        usermod -aG sudo devops
        mkdir -p /home/devops/.ssh
        chmod 700 /home/devops/.ssh
        chown -R devops:devops /home/devops
      SHELL

      # 2. Backup Server (Generates SSH keypair for app-server communication)
      if server[:name] == "backup-server"
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update -y
          apt-get install -y rsync ufw

          # Generate dedicated SSH key for devops if not present
          if [ ! -f /home/devops/.ssh/id_rsa ]; then
            su - devops -c "ssh-keygen -t rsa -b 2048 -N '' -f /home/devops/.ssh/id_rsa"
            mkdir -p /vagrant/.vagrant/keys
            cp /home/devops/.ssh/id_rsa.pub /vagrant/.vagrant/keys/backup_key.pub
          fi

          mkdir -p /var/backups/devops/latest
          chown -R devops:devops /var/backups/devops

          # Scan and store app-server host key automatically (eliminates StrictHostKeyChecking=no)
          mkdir -p /home/devops/.ssh
          ssh-keyscan -H 192.168.56.13 >> /home/devops/.ssh/known_hosts 2>/dev/null || true
          chown -R devops:devops /home/devops/.ssh

          # Automated Backup Script with --delete, /etc backup, and 30-day retention
          cat << 'EOF' > /usr/local/bin/backup-devops.sh
#!/bin/bash
set -e
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_DIR="/var/backups/devops"
mkdir -p "$BACKUP_DIR/latest"

ssh-keyscan -H 192.168.56.13 >> /home/devops/.ssh/known_hosts 2>/dev/null || true

# Rsync with --delete to prune stale files
SSH_OPTS="ssh -i /home/devops/.ssh/id_rsa -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/home/devops/.ssh/known_hosts"
rsync -avz --delete -e "$SSH_OPTS" devops@192.168.56.13:/home/devops/ "$BACKUP_DIR/latest/devops/"
rsync -avz --delete -e "$SSH_OPTS" devops@192.168.56.13:/etc/hosts "$BACKUP_DIR/latest/etc_hosts"

# Archive snapshot
tar -czf "$BACKUP_DIR/backup_$TIMESTAMP.tar.gz" -C "$BACKUP_DIR/latest" .

# Retention policy: delete archives older than 30 days
find "$BACKUP_DIR" -name "backup_*.tar.gz" -mtime +30 -delete
echo "Backup completed successfully at $TIMESTAMP"
EOF
          chmod +x /usr/local/bin/backup-devops.sh

          # Automated Restore Script
          cat << 'EOF' > /usr/local/bin/restore-devops.sh
#!/bin/bash
set -e
BACKUP_DIR="/var/backups/devops/latest/devops"
if [ ! -d "$BACKUP_DIR" ]; then
  echo "Error: No backup found in $BACKUP_DIR"
  exit 1
fi
echo "Restoring /home/devops to app-server (192.168.56.13)..."
rsync -avz -e "ssh -i /home/devops/.ssh/id_rsa -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/home/devops/.ssh/known_hosts" "$BACKUP_DIR/" devops@192.168.56.13:/home/devops/
echo "Restore complete!"
EOF
          chmod +x /usr/local/bin/restore-devops.sh

          # Weekly cron job on Sundays at 02:00
          echo "0 2 * * 0 root /usr/local/bin/backup-devops.sh >> /var/log/backup-devops.log 2>&1" > /etc/cron.d/weekly-devops-backup

          ufw --force reset
          ufw default deny incoming
          ufw default allow outgoing
          ufw allow 22/tcp
          ufw --force enable
        SHELL
      end

      # 3. Web Servers (web-01, web-02)
      if ["web-01", "web-02"].include?(server[:name])
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update -y
          apt-get install -y docker.io ufw
          systemctl enable --now docker
          usermod -aG docker vagrant
          usermod -aG docker devops

          # Build from /vagrant root context so nginx/ and app/frontend/ paths resolve
          if [ -d "/vagrant/app/frontend" ]; then
            docker build -f /vagrant/app/frontend/Dockerfile -t frontend:0.2 /vagrant
            docker rm -f frontend || true
            docker run -d --name frontend --hostname #{server[:name]} --restart unless-stopped -p 80:80 frontend:0.2
          fi

          # Firewall: Allow SSH, allow HTTP only from HAProxy (192.168.56.10)
          ufw --force reset
          ufw default deny incoming
          ufw default allow outgoing
          ufw allow 22/tcp
          ufw allow from 192.168.56.10 to any port 80 proto tcp
          ufw --force enable
        SHELL
      end

      # 4. App Server (Go Backend & SSH Key Authorization)
      if server[:name] == "app-server"
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update -y
          apt-get install -y docker.io ufw
          systemctl enable --now docker
          usermod -aG docker vagrant
          usermod -aG docker devops

          if [ -d "/vagrant/app/backend" ]; then
            docker build -t backend:latest /vagrant/app/backend
            docker rm -f backend || true
            docker run -d --name backend --restart unless-stopped -p 5000:5000 backend:latest
          fi

          # Authorize backup-server's devops SSH key
          if [ -f /vagrant/.vagrant/keys/backup_key.pub ]; then
            cat /vagrant/.vagrant/keys/backup_key.pub >> /home/devops/.ssh/authorized_keys
            chmod 600 /home/devops/.ssh/authorized_keys
            chown -R devops:devops /home/devops/.ssh
          fi

          # Firewall: Allow SSH, allow port 5000 only from web-01 and web-02, allow 22 from backup-server
          ufw --force reset
          ufw default deny incoming
          ufw default allow outgoing
          ufw allow 22/tcp
          ufw allow from 192.168.56.11 to any port 5000 proto tcp
          ufw allow from 192.168.56.12 to any port 5000 proto tcp
          ufw allow from 192.168.56.14 to any port 22 proto tcp
          ufw --force enable
        SHELL
      end

      # 5. Load Balancer (HAProxy & Protected Stats)
      if server[:name] == "load-balancer"
        node.vm.provision "shell", inline: <<-SHELL
          apt-get update -y
          apt-get install -y haproxy ufw

          # Configure HAProxy with credentials from .env
          cp /vagrant/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg
          sed -i 's|stats auth .*|stats auth #{stats_user}:#{stats_pass}|' /etc/haproxy/haproxy.cfg
          systemctl restart haproxy

          # Firewall: Allow SSH, HTTP (80), and restrict stats (8404) to admin host only
          ufw --force reset
          ufw default deny incoming
          ufw default allow outgoing
          ufw allow 22/tcp
          ufw allow 80/tcp
          ufw allow from 192.168.56.1 to any port 8404 proto tcp
          ufw --force enable
        SHELL
      end
    end
  end
end
